# Conjunto de datos mínimo de ejemplo para un endpoint SPARQL de prueba.
#
# Usa el MISMO vocabulario ECFO que consultan las cuatro consultas reales de la
# aplicación (rdf:value, ecfo:hasSourceUnit/hasTargetUnit como IRIs,
# ecfo:hasApplicablePeriod, ecfo:hasApplicableLocation, ecfo:hasEmissionSource,
# ecfo:hasEmissionTarget con el gas como IRI de Wikidata, etc.).
#
# Con estos datos, la búsqueda, la agrupación, la expansión de variantes, el
# detalle y la serie temporal devuelven resultados sin depender del endpoint
# público.

@prefix ecfo: <https://w3id.org/ecfo#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dc:   <http://purl.org/dc/elements/1.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix ex:   <http://example.org/cfkg/> .

#### Recursos auxiliares (actividad, unidades, localización, gas, alcance, etiqueta) ####

ex:diesel        rdfs:label "Diesel"@en .
ex:litre         rdfs:label "litre"@en .
ex:kgCO2e        rdfs:label "kg CO2e"@en .
wd:Q145          rdfs:label "United Kingdom"@en .   # Reino Unido
wd:Q1933140      rdfs:label "CO2e"@en .             # gas objetivo (CO2e) de GAS_IRI_MAP
ecfo:Scope1      rdfs:label "Scope 1"@en .
ex:tag-transport rdfs:label "transport"@en .

#### Factor "Diesel, Reino Unido, CO2e" para tres años (sirve para la serie temporal) ####

ex:diesel-uk-2019 a ecfo:EmissionConversionFactor ;
  rdfs:label "Diesel, UK, 2019"@en ;
  ecfo:hasEmissionSource     ex:diesel ;
  ecfo:hasEmissionTarget     wd:Q1933140 ;
  ecfo:hasSourceUnit         ex:litre ;
  ecfo:hasTargetUnit         ex:kgCO2e ;
  ecfo:hasApplicableLocation wd:Q145 ;
  ecfo:hasApplicablePeriod   "2019" ;
  ecfo:hasScope              ecfo:Scope1 ;
  ecfo:hasTag                ex:tag-transport ;
  rdf:value                  "2.70"^^xsd:decimal ;
  dc:publisher               <https://www.gov.uk/government/organisations/defra> ;
  prov:wasDerivedFrom        <https://example.org/source/defra-2019> .

ex:diesel-uk-2020 a ecfo:EmissionConversionFactor ;
  rdfs:label "Diesel, UK, 2020"@en ;
  ecfo:hasEmissionSource     ex:diesel ;
  ecfo:hasEmissionTarget     wd:Q1933140 ;
  ecfo:hasSourceUnit         ex:litre ;
  ecfo:hasTargetUnit         ex:kgCO2e ;
  ecfo:hasApplicableLocation wd:Q145 ;
  ecfo:hasApplicablePeriod   "2020" ;
  ecfo:hasScope              ecfo:Scope1 ;
  ecfo:hasTag                ex:tag-transport ;
  rdf:value                  "2.68"^^xsd:decimal ;
  dc:publisher               <https://www.gov.uk/government/organisations/defra> ;
  prov:wasDerivedFrom        <https://example.org/source/defra-2020> .

ex:diesel-uk-2021 a ecfo:EmissionConversionFactor ;
  rdfs:label "Diesel, UK, 2021"@en ;
  ecfo:hasEmissionSource     ex:diesel ;
  ecfo:hasEmissionTarget     wd:Q1933140 ;
  ecfo:hasSourceUnit         ex:litre ;
  ecfo:hasTargetUnit         ex:kgCO2e ;
  ecfo:hasApplicableLocation wd:Q145 ;
  ecfo:hasApplicablePeriod   "2021" ;
  ecfo:hasScope              ecfo:Scope1 ;
  ecfo:hasTag                ex:tag-transport ;
  rdf:value                  "2.61"^^xsd:decimal ;
  dc:publisher               <https://www.gov.uk/government/organisations/defra> ;
  prov:wasDerivedFrom        <https://example.org/source/defra-2021> .
